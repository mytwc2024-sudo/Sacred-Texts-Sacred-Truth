# =====================================================
# AKST ingestion pipeline — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (it is gitignored).
# =====================================================

# --- Supabase (EXTRA Ankhor MasterHub project) -------
# Project ref: xhzyavyftgyqzftlqdlz
SUPABASE_URL=https://xhzyavyftgyqzftlqdlz.supabase.co

# Service-role key — server-side ONLY. Grants full write access and
# bypasses RLS, so it must never ship to the browser / Lovable frontend.
# Get it from: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (embeddings) -----------------------------
OPENAI_API_KEY=
# Embedding model — must produce 1536-dim vectors to match the schema.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ingestion tuning (optional) ---------------------
# Milliseconds to wait between requests to sacred-texts.com (be polite).
INGEST_REQUEST_DELAY_MS=1500
# Target words per chunk before embedding.
INGEST_CHUNK_SIZE_WORDS=800
# Identify the crawler politely in the User-Agent header.
INGEST_USER_AGENT=AKST-Ingestion/0.1 (+https://github.com/mytwc2024-sudo/Sacred-Texts-Sacred-Truth)
